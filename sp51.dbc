CM_ "SP51 Gen5 PHEV pack (Preh EA443 AS4 SME, SWFL 00003e6f) K-CAN5 500k classic. Built 2026-11-03 from bench logs + AS4 firmware + F11 logs; BE = Battery-Emulator public map. Labels: [CONFIRMED] [ANALYSIS] [HYPOTHESIS] [FALLBACK]. No VIN/keys.";
CM_ BU_ SME "Preh EA443 storage management electronics (battery ECU)";
CM_ BU_ VCU "Vehicle side as emulated by bench playback / ZombieVerter (EME role)";
CM_ BU_ TESTER "UDS tester, read-only services only";
CM_ SG_ 274 I_Pack "[CONFIRMED SP51] pack current, (raw-8192)*0.1; ~-0.1 A at rest";
CM_ SG_ 274 U_Pack "[CONFIRMED SP51] pack (pre-contactor) voltage; 380.8 V; matches E554 cell sum";
CM_ SG_ 274 SME112_B4 "[ANALYSIS] raw byte (FF at rest)";
CM_ SG_ 274 SME112_B5_lo "[ANALYSIS] raw bits";
CM_ SG_ 274 OpenContactorReq "[FALLBACK BE] 2-bit enum 0 no_statement 1 not_active 2 active 3 invalid; stayed 1 throughout close holds [CONFIRMED SP51 value]";
CM_ SG_ 274 OpenInstantReq "[FALLBACK BE] instant-open request enum; 1 = not_active observed";
CM_ SG_ 274 OpenFastReq "[FALLBACK BE] fast-open request enum; 1 = not_active observed";
CM_ SG_ 274 SME112_B6_hi "[ANALYSIS] raw nibble (7)";
CM_ SG_ 274 U_Link_Est "[ANALYSIS] link/post-contactor voltage ~4 V/bit: 0 open, 0x5F=380 V closed, decays <80 ms on open (no cap); voltmeter confirmation pending";
CM_ BO_ 274 "SME HV status: pack I/V, open requests, link voltage. 20 ms [CONFIRMED SP51]. Starts ~110 ms after vehicle frames appear, only with HVIL closed [CONFIRMED SP51 runs 1-3].";
CM_ SG_ 506 IsoErrExt "[FALLBACK BE] enum; 1 not_active observed";
CM_ SG_ 506 IsoErrInt "[FALLBACK BE] enum; 1 not_active observed";
CM_ SG_ 506 CoolReq "[FALLBACK BE] cooling request enum";
CM_ SG_ 506 CoolValve "[FALLBACK BE] cooling valve enum";
CM_ SG_ 506 LockErr "[FALLBACK BE] interlock/locking error enum; 1 not_active observed";
CM_ SG_ 506 PrechargeLocked "[FALLBACK BE] precharge locked enum; 1 not_active observed";
CM_ SG_ 506 HV_State "[CONFIRMED SP51 runs 1+3] contactor state 4 OPEN, 5 PRECHARGE/closing, 6 CLOSED (close ack / HV ready). BE reads b1[5:4] as disconnect_sw 0/1/2";
CM_ SG_ 506 SvcReq "[FALLBACK BE] service request enum";
CM_ SG_ 506 EmergErr "[FALLBACK BE] emergency error enum";
CM_ SG_ 506 DisconnectErr "[FALLBACK BE] disconnect error enum";
CM_ SG_ 506 IsoWarn "[FALLBACK BE] isolation warning enum";
CM_ SG_ 506 SME1FA_B3 "[ANALYSIS] raw byte (7F)";
CM_ SG_ 506 T_HV "[FALLBACK BE] HV temperature, raw-50";
CM_ SG_ 506 SME1FA_B5 "[ANALYSIS] raw byte (FF)";
CM_ SG_ 506 T_CellMin "[ANALYSIS] min cell temp raw-50; 7 C matches DID DDC0 7.6 C";
CM_ SG_ 506 T_CellMax "[ANALYSIS] max cell temp raw-50; 8 C matches DID DDC0 8.7 C";
CM_ BO_ 506 "SME HV state / isolation / temps. 1000 ms cyclic + event on change to CLOSED [CONFIRMED SP51].";
CM_ SG_ 757 U_ChargeMax "[FALLBACK BE layout; ANALYSIS value] 453.1 V, matches DID E54C";
CM_ SG_ 757 I_ChargeMax "[FALLBACK BE layout+offset; ANALYSIS value] max charge current; 202.0-204.4 A observed (~7 C, 19 % SOC); 380 V x 202 A ~ 77 kW vs 0x40D 70 kW";
CM_ SG_ 757 U_DischargeMin "[FALLBACK BE layout; ANALYSIS value] 303.0 V, matches DID E54C";
CM_ SG_ 757 I_DischargeMax "[ANALYSIS] max discharge current 297.2 A (raw*0.1, NO offset); BE subtracts 819.2 which gives an impossible -522 A; 297 A x ~336 V ~ 100 kW matches 0x40D";
CM_ BO_ 757 "SME charge/discharge voltage+current limits. AS4 vehicle TX PDU idx 5 [CONFIRMED AS4]; 60-100 ms observed [CONFIRMED SP51]; layout [FALLBACK BE]. Unchanged by contactor close (no load).";
CM_ SG_ 569 SME239_B0 "[ANALYSIS] raw byte (00 then 31 after ~1 s)";
CM_ SG_ 569 E_Pred "[FALLBACK BE] predicted energy";
CM_ SG_ 569 E_ChargeTarget "[FALLBACK BE] predicted charge target";
CM_ SG_ 569 SME239_B5 "[ANALYSIS] raw";
CM_ SG_ 569 SME239_B6 "[ANALYSIS] raw";
CM_ SG_ 569 SME239_B7 "[ANALYSIS] raw";
CM_ BO_ 569 "SME predicted energy [FALLBACK BE]. One-frame change at main close (b1,b3) [ANALYSIS switching marker].";
CM_ SG_ 1037 P_Avail_Chg_ShortTerm "[FALLBACK BE layout; ANALYSIS plausibility] short-term charge power; 69.5-70.3 kW observed at ~7 C/19 % SOC, creeps up ~0.2 kW per 46 s rest";
